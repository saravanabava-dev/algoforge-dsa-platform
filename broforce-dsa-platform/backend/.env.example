# Copy this file to .env and adjust if needed. No external services required.

PORT=5000
NODE_ENV=development

# Local MongoDB — no internet / cloud account required
MONGO_URI=mongodb://127.0.0.1:27017/broforce_dsa

# Change this in any real deployment. Any long random string works offline.
JWT_SECRET=broforce_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call this API (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# Optional — Forgot Password emails. If left blank, reset links are printed
# to the backend console instead of emailed, so the feature still works on
# an offline lab network with no mail server configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
